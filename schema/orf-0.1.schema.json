{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-recall-format:schema:0.1",
  "title": "Open Recall Format 0.1 record",
  "description": "One product recall, as seen from the owner's side: which units are affected, how to recognise them, what the hazard is and what to do. See spec/open-recall-format-0.1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orf_version",
    "id",
    "source",
    "jurisdictions",
    "language",
    "published",
    "category",
    "title",
    "summary",
    "products",
    "hazards",
    "severity",
    "actions",
    "remedies"
  ],
  "properties": {
    "orf_version": { "const": "0.1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "description": "<authority in lower case>:<source id>, e.g. us-cpsc:25036"
    },
    "source": { "$ref": "#/$defs/source" },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([A-Z]{2}|EU)$" }
    },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "published": { "$ref": "#/$defs/date" },
    "updated": { "$ref": "#/$defs/date" },
    "category": { "$ref": "#/$defs/category" },
    "title": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "not": { "pattern": "(https?://|<[a-zA-Z/])" },
      "description": "One plain sentence an assistant can read aloud: no URLs, no markup."
    },
    "products": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/product" } },
    "hazards": { "type": "array", "items": { "$ref": "#/$defs/hazard" } },
    "hazard_text": { "type": "string" },
    "severity": { "$ref": "#/$defs/severity" },
    "actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/action" } },
    "remedies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/remedy" } },
    "instructions": { "type": "string" },
    "contact": { "$ref": "#/$defs/contact" },
    "firms": { "type": "array", "items": { "$ref": "#/$defs/firm" } },
    "incidents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "injuries": { "type": "integer", "minimum": 0 },
        "deaths": { "type": "integer", "minimum": 0 }
      }
    },
    "related": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "partialDate": {
      "type": "string",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "from": { "$ref": "#/$defs/partialDate" },
        "to": { "$ref": "#/$defs/partialDate" }
      }
    },
    "codeMatch": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefix"],
          "properties": { "prefix": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "codeList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/codeMatch" } },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "anyOf": [
        { "required": ["models"] },
        { "required": ["gtins"] },
        { "required": ["udi_di"] },
        { "required": ["vehicle"] },
        { "required": ["lots"] },
        { "required": ["serials"] },
        { "required": ["manufactured"] },
        { "required": ["date_mark"] }
      ],
      "properties": {
        "models": { "$ref": "#/$defs/codeList" },
        "gtins": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(\\d{8}|\\d{12,14})$" }
        },
        "udi_di": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "vehicle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["make"],
          "properties": {
            "make": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "years": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "type": "integer", "minimum": 1886 },
                "to": { "type": "integer", "minimum": 1886 }
              }
            }
          }
        },
        "lots": { "$ref": "#/$defs/codeList" },
        "serials": { "$ref": "#/$defs/codeList" },
        "manufactured": { "$ref": "#/$defs/dateRange" },
        "date_mark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "minProperties": 2,
          "properties": {
            "kind": { "enum": ["best_before", "use_by", "expiry", "other"] },
            "from": { "$ref": "#/$defs/partialDate" },
            "to": { "$ref": "#/$defs/partialDate" }
          }
        },
        "basis": { "enum": ["structured", "text"] },
        "note": { "type": "string" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "brands", "scope", "identification"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "brands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string" },
        "source_category": { "type": "string" },
        "gpc_brick": { "type": "string", "pattern": "^\\d{8}$" },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "approximate"],
            "properties": {
              "count": { "type": "integer", "minimum": 0 },
              "approximate": { "type": "boolean" },
              "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
            }
          }
        },
        "scope": { "enum": ["all_units", "listed_units", "unknown"] },
        "identification": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
        "identification_hint": { "type": "string" },
        "sold": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "where": { "type": "string" },
            "from": { "$ref": "#/$defs/partialDate" },
            "to": { "$ref": "#/$defs/partialDate" },
            "price": { "type": "string" }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://" },
              "caption": { "type": "string" }
            }
          }
        }
      },
      "if": { "properties": { "scope": { "const": "listed_units" } } },
      "then": { "properties": { "identification": { "type": "array", "minItems": 1 } } }
    },
    "hazard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/hazardType" },
        "allergen": { "$ref": "#/$defs/allergen" },
        "agent": { "type": "string", "minLength": 1 },
        "source_value": { "type": "string" }
      },
      "if": { "required": ["allergen"] },
      "then": { "properties": { "type": { "const": "undeclared_allergen" } } }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "enum": ["serious", "moderate", "low", "unknown"] },
        "source_value": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "id", "url", "licence", "attribution"],
      "properties": {
        "authority": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9-]+$" },
        "agency": { "type": "string" },
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "licence": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "retrieved": { "type": "string", "format": "date-time" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "text": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "firm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["recalling_firm", "manufacturer", "importer", "distributor", "retailer"] }
      }
    },
    "category": {
      "enum": [
        "food",
        "drug",
        "medical_device",
        "cosmetic",
        "vehicle",
        "vehicle_equipment",
        "child_restraint",
        "tire",
        "consumer_product",
        "other"
      ]
    },
    "hazardType": {
      "enum": [
        "fire",
        "burns",
        "electric_shock",
        "explosion",
        "choking",
        "suffocation",
        "strangulation",
        "entrapment",
        "drowning",
        "fall",
        "tip_over",
        "laceration",
        "injuries",
        "crash",
        "chemical",
        "poisoning",
        "microbiological",
        "undeclared_allergen",
        "foreign_material",
        "damage_to_sight",
        "damage_to_hearing",
        "environment",
        "health_risk",
        "other"
      ]
    },
    "allergen": {
      "enum": [
        "milk",
        "egg",
        "fish",
        "crustacean_shellfish",
        "molluscs",
        "tree_nuts",
        "peanuts",
        "wheat",
        "gluten",
        "soy",
        "sesame",
        "celery",
        "mustard",
        "lupin",
        "sulphites"
      ]
    },
    "action": {
      "enum": [
        "stop_using",
        "do_not_eat",
        "do_not_drive",
        "park_outside",
        "keep_away_from_children",
        "contact_firm",
        "contact_retailer",
        "contact_dealer",
        "return_to_store",
        "dispose",
        "get_repair",
        "check_with_doctor"
      ]
    },
    "remedy": { "enum": ["refund", "replacement", "repair", "instructions_or_label", "other", "none"] }
  }
}
