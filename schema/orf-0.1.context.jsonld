{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "orf": "urn:open-recall-format:vocab:0.1#",

    "orf_version": "orf:version",
    "id": "orf:id",
    "source": "orf:source",
    "authority": "orf:authority",
    "agency": "orf:agency",
    "licence": "schema:license",
    "attribution": "schema:creditText",
    "retrieved": { "@id": "orf:retrieved", "@type": "schema:DateTime" },
    "url": { "@id": "schema:url", "@type": "@id" },
    "jurisdictions": { "@id": "schema:spatialCoverage", "@container": "@set" },
    "language": "schema:inLanguage",
    "published": { "@id": "schema:datePublished", "@type": "schema:Date" },
    "updated": { "@id": "schema:dateModified", "@type": "schema:Date" },
    "category": { "@id": "orf:category", "@type": "@vocab" },
    "title": "schema:name",
    "summary": "schema:abstract",

    "products": { "@id": "orf:recalledProduct", "@container": "@set" },
    "name": "schema:name",
    "brands": { "@id": "schema:brand", "@container": "@set" },
    "description": "schema:description",
    "source_category": "schema:category",
    "gpc_brick": "orf:gpcBrick",
    "units": { "@id": "orf:unitsAffected", "@container": "@set" },
    "count": "schema:value",
    "approximate": "orf:approximate",
    "country": "schema:addressCountry",
    "scope": { "@id": "orf:scope", "@type": "@vocab" },
    "identification": { "@id": "orf:unitSelector", "@container": "@set" },
    "models": { "@id": "schema:model", "@container": "@set" },
    "gtins": { "@id": "schema:gtin", "@container": "@set" },
    "udi_di": { "@id": "orf:udiDeviceIdentifier", "@container": "@set" },
    "vehicle": "orf:vehicle",
    "make": "schema:manufacturer",
    "model": "schema:model",
    "years": "schema:vehicleModelDate",
    "lots": { "@id": "orf:lot", "@container": "@set" },
    "serials": { "@id": "orf:serialNumber", "@container": "@set" },
    "manufactured": "schema:productionDate",
    "date_mark": "orf:dateMark",
    "kind": "orf:kind",
    "prefix": "orf:prefix",
    "from": "orf:from",
    "to": "orf:to",
    "basis": "orf:basis",
    "note": "schema:comment",
    "identification_hint": "orf:identificationHint",
    "sold": "orf:sold",
    "where": "schema:areaServed",
    "price": "schema:price",
    "images": { "@id": "schema:image", "@container": "@set" },
    "caption": "schema:caption",

    "hazards": { "@id": "orf:hazard", "@container": "@set" },
    "type": { "@id": "orf:hazardType", "@type": "@vocab" },
    "allergen": { "@id": "orf:allergen", "@type": "@vocab" },
    "agent": "orf:agent",
    "source_value": "orf:sourceValue",
    "hazard_text": "orf:hazardText",
    "severity": "orf:severity",
    "level": { "@id": "orf:severityLevel", "@type": "@vocab" },
    "actions": { "@id": "orf:action", "@container": "@list", "@type": "@vocab" },
    "remedies": { "@id": "orf:remedy", "@container": "@set", "@type": "@vocab" },
    "instructions": "orf:instructions",
    "contact": "orf:contact",
    "text": "schema:description",
    "phone": "schema:telephone",
    "email": "schema:email",
    "firms": { "@id": "orf:firm", "@container": "@set" },
    "role": { "@id": "orf:role", "@type": "@vocab" },
    "incidents": "orf:incidents",
    "injuries": "orf:injuries",
    "deaths": "orf:deaths",
    "related": { "@id": "orf:related", "@container": "@set" },

    "@vocab": "urn:open-recall-format:vocab:0.1#"
  }
}
